# Doxygen configuration for fill-out-form (Python sources in src/).
# Generate the HTML documentation with:  doxygen Doxyfile
# Output goes to docs/doxygen/ (ignored by git).

PROJECT_NAME           = "fill-out-form"
PROJECT_BRIEF          = "Udemy 100 Days of Code, Day 48: fill out a form with Selenium"
PROJECT_NUMBER         = 0.1.0
OUTPUT_DIRECTORY       = docs/doxygen
CREATE_SUBDIRS         = NO
OUTPUT_LANGUAGE        = English

# Python sources
INPUT                  = src README.md
FILE_PATTERNS          = *.py *.md
RECURSIVE              = YES
EXCLUDE_PATTERNS       = */__pycache__/*
OPTIMIZE_OUTPUT_JAVA   = YES
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES
AUTOLINK_SUPPORT       = YES
MARKDOWN_SUPPORT       = YES
USE_MDFILE_AS_MAINPAGE = README.md
PYTHON_DOCSTRING       = YES

# Output formats
GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_LATEX         = NO
GENERATE_XML           = NO

# Diagrams are not needed and Graphviz is not required
HAVE_DOT               = NO
CLASS_DIAGRAMS         = NO

# Messages
QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
